# 默认按文本处理，仓库内统一使用 LF
* text=auto eol=lf

# 显式声明文本类型
*.md    text
*.json  text
*.yml   text
*.yaml  text
*.toml  text
*.ts    text
*.tsx   text
*.js    text
*.jsx   text
*.css   text
*.html  text
*.py    text

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.sqlite binary
*.parquet binary
