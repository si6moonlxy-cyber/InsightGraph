# InsightGraph 环境变量模板
# ================================================================
# ⚠️  安全须知 — 请务必阅读
# ================================================================
# 1. 此文件是密钥模板，请勿将真实的 .env 文件提交到 Git
#    （.gitignore 已忽略 .env / .env.*，仅保留 .env.example）。
# 2. 生产环境部署前，必须替换所有占位密钥为强随机字符串：
#    python -c "import secrets; print(secrets.token_urlsafe(48))"
# 3. API Key 禁止硬编码在源码、前端 public/ 目录或 index.html 中。
# 4. 若怀疑密钥泄露，立即轮换所有密钥并审查 Git 历史。
# ================================================================
# 使用方式:
#   本地开发: cp .env.example .env    （以下变量均有开发默认值，
#             仅 docker-compose.yml 与后续 backend 读取）
# ================================================================

# ==================== 基础设施（docker-compose.yml） ====================

# ---- PostgreSQL (pgvector) ----
POSTGRES_USER=insightgraph
# 生产环境必须替换：export POSTGRES_PASSWORD=$(openssl rand -hex 16)
POSTGRES_PASSWORD=insightgraph_dev
DB_NAME=insightgraph_dev

# ---- Neo4j (GraphRAG) ----
# 生产环境必须替换为强随机字符串（至少 8 位）
NEO4J_PASSWORD=insightgraph_dev

# ---- Redis ----
# 空 = 不启用认证（本地开发默认）；生产环境建议设置
REDIS_PASSWORD=

# ==================== 后端应用 ====================
# 后端统一通过 Pydantic Settings 管理。Phase 2A 骨架不连接外部适配器；
# 启用某个适配器后，对应配置才进入 fail-fast 校验。

# ---- Application ----
APP_ENV=development
PORT=4000
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# ---- Database（与上方基础设施变量对应） ----
DATABASE_URL=postgresql+asyncpg://insightgraph:insightgraph_dev@localhost:5432/insightgraph_dev

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# 与上方 NEO4J_PASSWORD 保持一致
NEO4J_PASSWORD=insightgraph_dev

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- LLM（统一走 backend/app/llm/ 网关） ----
# 按需填入；未配置 provider 时相关分析任务应明确失败或降级，不得静默吞掉
LLM_PROVIDER=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ---- GitHub（仓库分析采集，按需） ----
GITHUB_TOKEN=

# ---- CodeGraphAI（步骤 5 M2；默认关闭，机器路径不入库） ----
CODEGRAPH_ENGINE_ENABLED=false
CODEGRAPH_ENGINE_PATH=
CODEGRAPH_ENGINE_TIMEOUT_SECONDS=30
# 整批引擎查询超过此预算即熔断并返回 scanner-only 完整结果
CODEGRAPH_ENGINE_TOTAL_BUDGET_SECONDS=900

# ==================== 分阶段 fail-fast 清单 ====================
# PostgreSQL 适配器启用后：DATABASE_URL 必填
# Neo4j 适配器启用后：NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD 必填
# Redis 适配器启用后：REDIS_URL 必填
# 任一 LLM Provider 启用后：Provider 名称与对应 API Key 必须完整
# CodeGraph 引擎启用后：CODEGRAPH_ENGINE_PATH 必填；不可用时扫描降级为 scanner-only
# 生产环境：DEBUG=true 时拒绝启动
